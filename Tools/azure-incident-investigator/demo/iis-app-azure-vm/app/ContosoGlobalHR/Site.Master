<%@ Master Language="C#" AutoEventWireup="true" %>
<%@ Import Namespace="ContosoHR" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contoso Global HR</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body { background: #f4f6f9; }
        .sidebar { min-height: 100vh; background: #343a40; color: #c2c7d0; }
        .sidebar a { color: #c2c7d0; text-decoration: none; display: block; padding: 12px 20px; }
        .sidebar a:hover, .sidebar a.active { background: #494e54; color: #fff; }
        .brand { font-weight: 700; font-size: 1.15rem; color: #fff; padding: 18px 20px; border-bottom: 1px solid #4b545c; }
        .env-badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
        .env-PRD  { background: #dc3545; color: #fff; }
        .env-NPRD { background: #198754; color: #fff; }
        .tile { border-radius: 8px; padding: 20px; color: #fff; }
        .tile .num { font-size: 2.4rem; font-weight: 700; }
        .tile .lbl { font-size: 0.9rem; opacity: .85; }
        .tile-1 { background: #0d6efd; } .tile-2 { background: #198754; }
        .tile-3 { background: #ffc107; color: #212529; } .tile-4 { background: #6f42c1; }
        .content { padding: 24px; }
        .card { border: none; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    </style>
    <asp:ContentPlaceHolder id="head" runat="server" />
</head>
<body>
<form runat="server">
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 sidebar p-0">
                <div class="brand">
                    <i class="bi bi-buildings"></i>&nbsp;Contoso Global HR
                    <div class="mt-2"><span class="env-badge env-<%= DataAccess.EnvPrefix %>"><%= DataAccess.EnvPrefix %></span></div>
                </div>
                <a href="Default.aspx"><i class="bi bi-speedometer2"></i>&nbsp; Dashboard</a>
                <a href="Employees.aspx"><i class="bi bi-people"></i>&nbsp; Employees</a>
                <a href="Departments.aspx"><i class="bi bi-diagram-3"></i>&nbsp; Departments</a>
                <a href="Countries.aspx"><i class="bi bi-globe2"></i>&nbsp; Global Presence</a>
                <a href="Timesheets.aspx"><i class="bi bi-clock-history"></i>&nbsp; Timesheets</a>
                <a href="Reports.aspx"><i class="bi bi-bar-chart"></i>&nbsp; Reports</a>
                <div class="p-3 mt-4" style="border-top: 1px solid #4b545c; font-size: 0.75rem;">
                    <div>Host: <%= Environment.MachineName %></div>
                    <div>Now:&nbsp; <%= DateTime.Now.ToString("yyyy-MM-dd HH:mm") %></div>
                </div>
            </nav>
            <main class="col-md-10 content">
                <asp:ContentPlaceHolder id="main" runat="server" />
            </main>
        </div>
    </div>
</form>
</body>
</html>
